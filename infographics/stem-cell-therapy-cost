8px 0 4px;\">\n      <sc-for list=\"{{ gridlines }}\" as=\"g\" hint-placeholder-count=\"6\">\n        <div style=\"{{ g.overlayStyle }}\"><\u002Fdiv>\n      <\u002Fsc-for>\n      <sc-for list=\"{{ countries }}\" as=\"c\" hint-placeholder-count=\"12\">\n        <div style=\"display:flex;align-items:center;height:70px;position:relative;\">\n          <div style=\"width:250px;flex-shrink:0;display:flex;align-items:center;gap:10px;padding-right:16px;\">\n            <span style=\"font-size:22px;line-height:1;flex-shrink:0;\">{{ c.flag }}<\u002Fspan>\n            <span style=\"font-family: var(--font-subhead); font-size: 19px; font-weight: var(--fw-semibold); color: var(--white); width: 150px\">{{ c.name }}<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"flex:1;position:relative;height:100%;\">\n            <div style=\"{{ c.barStyle }}\"><\u002Fdiv>\n            <div style=\"{{ c.minDotStyle }}\"><\u002Fdiv>\n            <div style=\"{{ c.maxDotStyle }}\"><\u002Fdiv>\n            <div style=\"{{ c.arrowStyle }}\">\n              <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 6l6 6-6 6\"><\u002Fpath><\u002Fsvg>\n            <\u002Fdiv>\n            <div style=\"{{ c.minLabelStyle }}\">{{ c.minLabel }}<\u002Fdiv>\n            <div style=\"{{ c.maxLabelStyle }}\">{{ c.maxLabel }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;align-items:center;margin-top:4px;\">\n      <div style=\"width:250px;flex-shrink:0;\"><\u002Fdiv>\n      <div style=\"flex:1;position:relative;height:14px;\">\n        <div style=\"position:absolute;left:0;right:22px;top:0;height:1px;background:var(--line-on-dark-strong);\"><\u002Fdiv>\n        <div style=\"position:absolute;right:0;top:-6px;color:var(--text-on-dark-muted);\">\n          <svg width=\"14\" height=\"14\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 6l6 6-6 6\"><\u002Fpath><\u002Fsvg>\n        <\u002Fdiv>\n        <sc-for list=\"{{ gridlines }}\" as=\"g\" hint-placeholder-count=\"6\">\n          <div style=\"{{ g.tickStyle }}\"><\u002Fdiv>\n          <div style=\"{{ g.labelStyle }}\">{{ g.label }}<\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;justify-content:center;margin:22px 0 4px;\">\n      <div style=\"font-family:var(--font-body);font-size:var(--eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--sand-400);\">Indicative treatment price in USD<\u002Fdiv>\n    <\u002Fdiv>\n\n  <\u002Fdiv>\n\n  <div style=\"display:flex;justify-content:center;margin-bottom:48px;\">\n    <div style=\"display:inline-block;white-space:nowrap;flex-shrink:0;\">\n      <x-import component-from-global-scope=\"STEMCIERGEDesignSystem_3c00fd.Badge\" variant=\"pill-on-dark\" hint-size=\"auto,40px\">Lower advertised price does not always mean lower total cost.<\u002Fx-import>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display:flex;gap:32px;margin-bottom:48px;align-items:stretch;\">\n    <div style=\"flex:1;background:var(--ink-800);border-radius:var(--radius-lg);box-shadow:var(--shadow-card-dark);border:1px solid var(--line-on-dark);padding:40px 44px;display:flex;gap:24px;align-items:flex-start;\">\n      <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:oklch(from var(--sand-500) l c h / 0.14);display:flex;align-items:center;justify-content:center;color:var(--sand-400);\">\n        <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"><\u002Fcircle><path d=\"M12 8h.01M11 12h1v5h1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><\u002Fpath><\u002Fsvg>\n      <\u002Fdiv>\n      <div>\n        <div style=\"font-family:var(--font-body);font-size:var(--eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--sand-400);margin-bottom:12px;\">Main insight<\u002Fdiv>\n        <div style=\"font-family:var(--font-body);font-size:var(--body);line-height:var(--lh-relaxed);color:var(--text-on-dark-secondary);\">Price gaps often reflect different protocols, not the same treatment at different prices. Published ranges may represent different cell products, doses, delivery methods, treatment schedules and levels of care. Compare the complete medical and travel-adjusted package, not the headline figure alone.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"flex:1;background:var(--ink-800);border:1px solid var(--line-on-dark);border-radius:var(--radius-lg);box-shadow:var(--shadow-card-dark);padding:40px 44px;display:flex;gap:24px;align-items:flex-start;\">\n      <div style=\"flex-shrink:0;width:40px;height:40px;border-radius:50%;background:oklch(from var(--sand-500) l c h / 0.14);display:flex;align-items:center;justify-content:center;color:var(--sand-400);\">\n        <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 3.5l9.5 16.5h-19z\"><\u002Fpath><path d=\"M12 9.5v5M12 17.5h.01\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><\u002Fpath><\u002Fsvg>\n      <\u002Fdiv>\n      <div>\n        <div style=\"font-family:var(--font-body);font-size:var(--eyebrow);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--sand-400);margin-bottom:12px;\">Important note<\u002Fdiv>\n        <div style=\"font-family:var(--font-body);font-size:var(--body);line-height:var(--lh-relaxed);color:var(--text-on-dark-secondary);\">Prices are indicative estimates based on published provider information and market examples, not standardized national averages. Actual costs may vary by condition, protocol, cell source, dose, clinic and included services. For educational purposes only and does not constitute medical or financial advice.<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"border-top:1px solid var(--line-on-dark);padding-top:32px;display:flex;justify-content:space-between;align-items:center;gap:32px;\">\n    <p style=\"font-family:var(--font-body);font-size:15px;letter-spacing:var(--ls-normal);color:var(--text-on-dark-muted);margin:0;font-style:italic;\">Source: Publicly available provider pricing, published research and STEMCIERGE market analysis. Updated August 2026.<\u002Fp>\n    <div style=\"font-family:var(--font-body);font-size:15px;letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--sand-400);flex-shrink:0;\">www.stemcierge.com © 2026. All rights reserved.<\u002Fdiv>\n  <\u002Fdiv>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:2200,&quot;height&quot;:2200},&quot;scaleMax&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:55000,&quot;min&quot;:40000,&quot;max&quot;:80000,&quot;step&quot;:5000,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Chart&quot;},&quot;showOpenEndedArrows&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Chart&quot;}}\">\nclass Component extends DCLogic {\n  renderVals() {\n    const scaleMax = this.props.scaleMax ?? 55000;\n    const showArrows = this.props.showOpenEndedArrows ?? true;\n    const pct = v => Math.min(v / scaleMax * 100, 100);\n    const fmt = v => '$' + v.toLocaleString('en-US');\n\n    const raw = [\n      { name: 'Thailand', flag: '🇹🇭', min: 3000, max: 15000 },\n      { name: 'Mexico', flag: '🇲🇽', min: 4000, max: 18500 },\n      { name: 'Colombia', flag: '🇨🇴', min: 3500, max: 15000 },\n      { name: 'Malaysia', flag: '🇲🇾', min: 5500, max: 20000 },\n      { name: 'India', flag: '🇮🇳', min: 6000, max: 10000 },\n      { name: 'Turkey', flag: '🇹🇷', min: 3500, max: 22000 },\n      { name: 'South Korea', flag: '🇰🇷', min: 6000, max: 25000 },\n      { name: 'Germany', flag: '🇩🇪', min: 8000, max: 20000 },\n      { name: 'Japan', flag: '🇯🇵', min: 10000, max: 50000 },\n      { name: 'UAE', flag: '🇦🇪', min: 9500, max: 20000 },\n      { name: 'USA', flag: '🇺🇸', min: 4000, max: 20000 },\n      { name: 'Panama', flag: '🇵🇦', min: 26900, max: 26900, forceEdge: true, highlight: true },\n    ];\n\n    const labelColW = 250;\n    const calcLeft = leftPct => 'calc(' + labelColW + 'px + (100% - ' + labelColW + 'px) * ' + (leftPct / 100) + ')';\n\n    const countries = raw.map(c => {\n      const leftPct = pct(c.min);\n      const rightPct = c.forceEdge ? 100 : pct(c.max);\n      const widthPct = Math.max(rightPct - leftPct, 0);\n      const dotSize = c.highlight ? '20px' : '14px';\n      return {\n        name: c.name,\n        flag: c.flag,\n        barStyle: {\n          position: 'absolute', left: leftPct + '%', width: widthPct + '%', top: '50%',\n          height: c.highlight ? '15px' : '13px',\n          background: 'linear-gradient(90deg, var(--sand-600), var(--sand-300))',\n          borderRadius: 'var(--radius-pill)', transform: 'translateY(-50%)',\n        },\n        tailStyle: { display: 'none' },\n        arrowStyle: {\n          position: 'absolute', left: 'calc(' + rightPct + '% - 2px)', top: '50%',\n          transform: 'translateY(-50%)', color: 'var(--sand-100)',\n          opacity: showArrows ? 1 : 0,\n        },\n        minDotStyle: {\n          position: 'absolute', left: leftPct + '%', top: '50%', width: '11px', height: '11px',\n          borderRadius: '50%', background: 'var(--sand-100)', transform: 'translate(-50%,-50%)',\n        },\n        maxDotStyle: {\n          position: 'absolute', left: rightPct + '%', top: '50%', width: dotSize, height: dotSize,\n          borderRadius: '50%', background: 'var(--sand-100)',\n          boxShadow: c.highlight ? '0 0 0 4px oklch(from var(--sand-300) l c h / 0.22)' : 'none',\n          opacity: 0,\n          transform: 'translate(-50%,-50%)',\n        },\n        minLabelStyle: {\n          position: 'absolute', left: leftPct + '%', top: '50%',\n          transform: 'translate(calc(-100% - 16px), -50%)', whiteSpace: 'nowrap',\n          fontFamily: 'var(--font-body)', fontSize: '15px', color: 'var(--text-on-dark-secondary)',\n        },\n        maxLabelStyle: {\n          position: 'absolute', left: rightPct + '%', top: '50%',\n          transform: c.forceEdge ? 'translate(20px, -50%)' : 'translate(20px, -50%)',\n          whiteSpace: 'nowrap', fontFamily: 'var(--font-subhead)', fontSize: c.highlight ? '18px' : '16px',\n          fontWeight: 'var(--fw-semibold)', color: 'var(--sand-300)',\n        },\n        minLabel: fmt(c.min),\n        maxLabel: c.forceEdge ? '+' : (fmt(c.max) + '+'),\n      };\n    });\n\n    const gridlines = [0, 10000, 20000, 30000, 40000, 50000].map(v => ({\n      tickStyle: {\n        position: 'absolute', left: pct(v) + '%', top: 0, width: '1px', height: '8px',\n        background: 'var(--line-on-dark-strong)', transform: 'translateX(-50%)',\n      },\n      labelStyle: {\n        position: 'absolute', left: pct(v) + '%', top: '16px', transform: 'translateX(-50%)',\n        fontFamily: 'var(--font-body)', fontSize: '13px', letterSpacing: 'var(--ls-wide)',\n        color: 'var(--text-on-dark-muted)', whiteSpace: 'nowrap',\n      },\n      overlayStyle: {\n        position: 'absolute', left: calcLeft(pct(v)), top: 0, bottom: 0, width: '1px',\n        borderLeft: '1px dashed var(--line-on-dark-strong)',\n      },\n      label: v === 0 ? '$0' : '$' + (v / 1000) + 'K',\n    }));\n\n    return { countries, gridlines };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
